{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource/barlow": "^5.3.0",
        "@fontsource/barlow-condensed": "^5.3.0",
        "@tailwindcss/vite": "^4.1.11",
        "concurrently": "^10.0.6",
        "laravel-vite-plugin": "^3.2",
        "tailwindcss": "^4.0.7",
        "vite": "^8.3.5"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.65.0",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10"
    },
    "lint-staged": {
        "**/*.php": [
            "vendor/bin/pint"
        ],
        "**/*.{js,css,json}": [
